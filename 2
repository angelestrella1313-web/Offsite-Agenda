function closeConfig() { document.getElementById('config-overlay').classList.remove('open'); }

function saveConfig() {
  config.company = document.getElementById('cfg-company').value;
  config.event = document.getElementById('cfg-event').value;
  config.location = document.getElementById('cfg-location').value;
  config.dates = document.getElementById('cfg-dates').value;
  config.hotel = document.getElementById('cfg-hotel').value;
  config.hotelAddr = document.getElementById('cfg-hotel-addr').value;
  config.checkin = document.getElementById('cfg-checkin').value;
  config.checkout = document.getElementById('cfg-checkout').value;
  config.office = document.getElementById('cfg-office').value;
  config.officeAddr = document.getElementById('cfg-office-addr').value;
  config.officePhone = document.getElementById('cfg-office-phone').value;
  config.coordinator = document.getElementById('cfg-coordinator').value;
  config.coordinatorPhone = document.getElementById('cfg-coordinator-phone').value;
  config.wifiName = document.getElementById('cfg-wifi-name').value;
  config.wifiPass = document.getElementById('cfg-wifi-pass').value;
  localStorage.setItem('offsite-config', JSON.stringify(config));
  applyConfig();
  closeConfig();
}

