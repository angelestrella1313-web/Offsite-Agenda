<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Company Offsite</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --teal: #003B4A;
    --teal-mid: #004d61;
    --teal-light: #005f78;
    --accent: #c8860a;
    --accent-warm: #e09b20;
    --bg: #f5f0ea;
    --bg-card: #ffffff;
    --text: #1a1a1a;
    --text-muted: #6b6b6b;
    --border: rgba(0,59,74,0.12);
    --shadow: 0 2px 16px rgba(0,59,74,0.10);
    --radius: 14px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
    overflow-x: hidden;
  }

  /* ===== CONFIG PANEL ===== */
  #config-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  #config-overlay.open { display: flex; }
  .config-panel {
    background: white;
    border-radius: 20px;
    padding: 28px 24px;
    width: 90%;
    max-width: 420px;
    max-height: 85vh;
    overflow-y: auto;
  }
  .config-panel h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--teal);
    margin-bottom: 20px;
  }
  .config-field { margin-bottom: 16px; }
  .config-field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin-bottom: 6px;
  }
  .config-field input, .config-field textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg);
    outline: none;
    transition: border-color 0.2s;
  }
  .config-field input:focus, .config-field textarea:focus {
    border-color: var(--teal);
  }
  .config-field textarea { resize: vertical; min-height: 70px; }
  .config-actions { display: flex; gap: 10px; margin-top: 20px; }
  .btn-save {
    flex: 1; padding: 12px;
    background: var(--teal);
    color: white;
    border: none; border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-save:hover { background: var(--teal-light); }
  .btn-cancel {
    padding: 12px 20px;
    background: transparent;
    color: var(--text-muted);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem; cursor: pointer;
  }

  /* ===== HEADER ===== */
  .site-header {
    background: linear-gradient(160deg, var(--teal) 0%, var(--teal-mid) 60%, #006b88 100%);
    padding: 50px 24px 32px;
    position: relative;
    overflow: hidden;
  }
  .site-header::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 20%, rgba(200,134,10,0.18) 0%, transparent 60%),
                radial-gradient(ellipse at 10% 80%, rgba(255,255,255,0.06) 0%, transparent 50%);
  }
  .site-header::after {
    content: '';
    position: absolute;
    right: -40px; top: -40px;
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }
  .company-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.65);
    margin-bottom: 6px;
  }
  .event-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.1rem;
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 6px;
  }
  .event-meta {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.7);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .event-meta svg { opacity: 0.7; }
  .settings-btn {
    background: rgba(255,255,255,0.12);
    border: none;
    border-radius: 50%;
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .settings-btn:hover { background: rgba(255,255,255,0.22); }
  .settings-btn svg { color: white; }

  /* ===== COUNTDOWN ===== */
  .countdown-bar {
    background: rgba(255,255,255,0.12);
    border-radius: 8px;
    padding: 8px 14px;
    margin-top: 18px;
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .countdown-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent-warm);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  .countdown-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ===== NAV ===== */
  .bottom-nav {
    position: fixed;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 100%; max-width: 480px;
    background: white;
    border-top: 1px solid var(--border);
    display: flex;
    z-index: 100;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
  }
  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 4px 14px;
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    gap: 4px;
    transition: color 0.2s;
  }
  .nav-item.active { color: var(--teal); }
  .nav-item svg { width: 20px; height: 20px; }

  /* ===== PAGES ===== */
  .page { display: none; padding-bottom: 80px; }
  .page.active { display: block; }

  /* ===== AGENDA PAGE ===== */
  .day-tabs {
    display: flex;
    gap: 8px;
    padding: 20px 24px 4px;
  }
  .day-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 14px;
    border-radius: 12px;
    cursor: pointer;
    border: none;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
  }
  .day-tab.active {
    background: var(--teal);
    color: white;
  }
  .day-tab:not(.active) { color: var(--text-muted); }
  .day-tab-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .day-tab-num { font-size: 1.3rem; font-weight: 700; line-height: 1.2; }

  .day-heading {
    padding: 16px 24px 4px;
  }
  .day-heading h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.7rem;
    color: var(--teal);
  }
  .day-heading p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .agenda-list { padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }

  .agenda-item {
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .agenda-item:active { transform: scale(0.98); }
  .agenda-item-header {
    display: flex;
    align-items: center;
    padding: 16px 18px;
    gap: 14px;
  }
  .agenda-time {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    min-width: 58px;
  }
  .agenda-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: rgba(0,59,74,0.08);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .agenda-icon svg { width: 16px; height: 16px; color: var(--teal); }
  .agenda-name {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .agenda-chevron {
    color: var(--text-muted);
    transition: transform 0.25s;
    flex-shrink: 0;
  }
  .agenda-item.open .agenda-chevron { transform: rotate(180deg); }

  .agenda-detail {
    display: none;
    padding: 0 18px 16px 18px;
    border-top: 1px solid var(--border);
    margin-top: 0;
    animation: slideDown 0.2s ease;
  }
  .agenda-item.open .agenda-detail { display: block; }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .agenda-detail p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    padding-top: 12px;
  }
  .detail-location {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--teal);
    font-weight: 500;
    margin-top: 8px;
  }
  .detail-location svg { width: 13px; height: 13px; }

  /* ===== SECTION PAGES (Venue/Office/Tips) ===== */
  .section-header {
    padding: 28px 24px 20px;
  }
  .section-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.9rem;
    color: var(--teal);
    line-height: 1.2;
  }
  .section-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .info-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin: 0 16px 12px;
    overflow: hidden;
  }
  .info-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    cursor: pointer;
    gap: 12px;
  }
  .info-card-left {
    display: flex; align-items: center; gap: 12px;
  }
  .info-card-icon {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: rgba(0,59,74,0.08);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .info-card-icon svg { width: 16px; height: 16px; color: var(--teal); }
  .info-card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .info-card-chevron { color: var(--text-muted); transition: transform 0.25s; }
  .info-card.open .info-card-chevron { transform: rotate(180deg); }

  .info-card-body {
    display: none;
    padding: 0 18px 16px;
    border-top: 1px solid var(--border);
  }
  .info-card.open .info-card-body { display: block; animation: slideDown 0.2s ease; }
  .info-card-body p {
    font-size: 0.87rem;
    color: var(--text-muted);
    line-height: 1.6;
    padding-top: 12px;
  }
  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.87rem;
  }
  .info-row:last-child { border-bottom: none; }
  .info-row-label { color: var(--text-muted); }
  .info-row-value { font-weight: 600; color: var(--teal); }

  .venue-hero {
    background: var(--teal);
    margin: 0 16px 16px;
    border-radius: var(--radius);
    padding: 22px 20px;
    position: relative;
    overflow: hidden;
  }
  .venue-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 90% 10%, rgba(200,134,10,0.25), transparent 60%);
  }
  .venue-hero-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 6px;
    position: relative;
  }
  .venue-hero-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: white;
    position: relative;
    margin-bottom: 4px;
  }
  .venue-hero-addr {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.65);
    position: relative;
    display: flex; align-items: center; gap: 4px;
  }
  .nav-btn {
    margin-top: 14px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: white;
    color: var(--teal);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .nav-btn:hover { opacity: 0.88; }

  /* ===== QUOTES PAGE ===== */
  .add-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--teal);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 9px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .add-btn:hover { background: var(--teal-light); }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    text-align: center;
    gap: 12px;
  }
  .empty-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: rgba(0,59,74,0.08);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 4px;
  }
  .empty-icon svg { width: 28px; height: 28px; color: var(--text-muted); }
  .empty-state h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--text);
  }
  .empty-state p { font-size: 0.87rem; color: var(--text-muted); }

  .page-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 28px 24px 16px;
  }

  .quote-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin: 0 16px 12px;
    padding: 20px 20px 16px;
    position: relative;
  }
  .quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    color: var(--teal);
    opacity: 0.15;
    line-height: 1;
    position: absolute;
    top: 10px; left: 18px;
  }
  .quote-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    padding-top: 20px;
    padding-left: 4px;
  }
  .quote-author {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--teal);
    margin-top: 10px;
    letter-spacing: 0.03em;
  }
  .quote-delete {
    position: absolute;
    top: 12px; right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }
  .quote-delete:hover { color: #c0392b; background: #ffeaea; }

  /* ===== PHOTOS PAGE ===== */
  .photos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 16px;
  }
  .photo-card {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1;
    position: relative;
    background: rgba(0,59,74,0.08);
    cursor: pointer;
  }
  .photo-card img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-card .photo-delete {
    position: absolute;
    top: 6px; right: 6px;
    background: rgba(0,0,0,0.55);
    border: none;
    border-radius: 50%;
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: white;
  }

  /* ===== MODAL ===== */
  .modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 500;
    align-items: flex-end;
    justify-content: center;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: white;
    border-radius: 20px 20px 0 0;
    padding: 28px 24px 36px;
    width: 100%; max-width: 480px;
    animation: slideUp 0.3s ease;
  }
  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .modal h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--teal);
    margin-bottom: 18px;
  }
  .modal-field { margin-bottom: 14px; }
  .modal-field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 6px;
  }
  .modal-field input, .modal-field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    background: var(--bg);
  }
  .modal-field input:focus, .modal-field textarea:focus { border-color: var(--teal); }
  .modal-field textarea { resize: vertical; min-height: 80px; }
  .modal-actions { display: flex; gap: 10px; margin-top: 20px; }

  /* ===== PHOTO UPLOAD ===== */
  .photo-upload-area {
    border: 2px dashed var(--border);
    border-radius: 12px;
    padding: 30px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    margin-bottom: 16px;
  }
  .photo-upload-area:hover {
    border-color: var(--teal);
    background: rgba(0,59,74,0.03);
  }
  .photo-upload-area svg { color: var(--text-muted); margin-bottom: 8px; }
  .photo-upload-area p { font-size: 0.87rem; color: var(--text-muted); }
  #photo-file-input { display: none; }
  #photo-preview {
    width: 100%; height: 160px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 14px;
    display: none;
  }

  /* ===== TIPS PAGE ===== */
  .tips-section { margin-bottom: 10px; }
</style>
</head>
<body>

<!-- CONFIG OVERLAY -->
<div id="config-overlay">
  <div class="config-panel">
    <h2>Edit Event Details</h2>
    <div class="config-field">
      <label>Company Name</label>
      <input type="text" id="cfg-company" placeholder="Your Company">
    </div>
    <div class="config-field">
      <label>Event Name</label>
      <input type="text" id="cfg-event" placeholder="Company Offsite">
    </div>
    <div class="config-field">
      <label>Location</label>
      <input type="text" id="cfg-location" placeholder="Your City, State">
    </div>
    <div class="config-field">
      <label>Date Range</label>
      <input type="text" id="cfg-dates" placeholder="January 15–17, 2027">
    </div>
    <div class="config-field">
      <label>Hotel / Venue Name</label>
      <input type="text" id="cfg-hotel" placeholder="Hotel Name TBD">
    </div>
    <div class="config-field">
      <label>Venue Address</label>
      <input type="text" id="cfg-hotel-addr" placeholder="123 Main St, City, State">
    </div>
    <div class="config-field">
      <label>Check-in Time</label>
      <input type="text" id="cfg-checkin" placeholder="4:00 PM">
    </div>
    <div class="config-field">
      <label>Checkout Time</label>
      <input type="text" id="cfg-checkout" placeholder="11:00 AM">
    </div>
    <div class="config-field">
      <label>Office / HQ Name</label>
      <input type="text" id="cfg-office" placeholder="Company HQ">
    </div>
    <div class="config-field">
      <label>Office Address</label>
      <input type="text" id="cfg-office-addr" placeholder="123 Main St, Suite 100, City, ST 00000">
    </div>
    <div class="config-field">
      <label>Office Phone</label>
      <input type="text" id="cfg-office-phone" placeholder="555-000-0000">
    </div>
    <div class="config-field">
      <label>Event Coordinator Name</label>
      <input type="text" id="cfg-coordinator" placeholder="Your EA Name">
    </div>
    <div class="config-field">
      <label>Coordinator Phone</label>
      <input type="text" id="cfg-coordinator-phone" placeholder="+1 555-000-0000">
    </div>
    <div class="config-field">
      <label>Wi-Fi Name</label>
      <input type="text" id="cfg-wifi-name" placeholder="OfficeGuest">
    </div>
    <div class="config-field">
      <label>Wi-Fi Password</label>
      <input type="text" id="cfg-wifi-pass" placeholder="password123">
    </div>
    <div class="config-actions">
      <button class="btn-cancel" onclick="closeConfig()">Cancel</button>
      <button class="btn-save" onclick="saveConfig()">Save Changes</button>
