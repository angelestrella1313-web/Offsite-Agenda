function updateCountdown() {
  // Parse dates from dates string
  const now = new Date();
  // Try to find a start date from the dates field
  const dateStr = get('dates');
  // Simple: look for "January 15" style
  const match = dateStr.match(/([A-Za-z]+)\s+(\d+)/);
  if (match) {
    const year = dateStr.match(/\d{4}/)?.[0] || now.getFullYear() + 1;
    const d = new Date(`${match[1]} ${match[2]}, ${year}`);
    const diff = Math.round((d - now) / 86400000);
    if (diff > 0) document.getElementById('h-countdown').textContent = `Trip starts in ${diff} days`;
    else if (diff === 0) document.getElementById('h-countdown').textContent = 'Today is the day!';
    else document.getElementById('h-countdown').textContent = `Trip was ${Math.abs(diff)} days ago`;
  }
}

